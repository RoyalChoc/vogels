{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Launch webapp (Chrome)",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:5173",
      "webRoot": "${workspaceFolder}/webapp",
      "preLaunchTask": "dev: webapp",
      "sourceMapPathOverrides": {
        "webpack:///./~/*": "${webRoot}/node_modules/*",
        "webpack:///./*": "${webRoot}/*",
        "webpack:///*": "*"
      }
    },
    {
      "name": "Launch webapp (Edge)",
      "type": "msedge",
      "request": "launch",
      "url": "http://localhost:5173",
      "webRoot": "${workspaceFolder}/webapp",
      "preLaunchTask": "dev: webapp"
    }
  ]
}
